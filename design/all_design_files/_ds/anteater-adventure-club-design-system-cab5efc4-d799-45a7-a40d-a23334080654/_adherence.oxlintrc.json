{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/board/**",
              "components/core/**",
              "components/events/**",
              "components/membership/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/polaroid/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lazydog|Chivo))/i]",
        "message": "Font not provided by the design system. Available: Lazydog, Chivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='BenefitItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|key|ref|className|style|children)$/]",
        "message": "<BenefitItem> doesn't accept that prop. Declared props: number, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|target|onClick|iconSrc|iconAlt|disabled|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, target, onClick, iconSrc, iconAlt, disabled, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cta|outline|payment|discord|instagram)$/]",
        "message": "<Button> variant must be one of 'cta' | 'outline' | 'payment' | 'discord' | 'instagram'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|tagline|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: year, tagline."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|as|className|style|children|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: variant, as, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:panel|option)$/]",
        "message": "<GlassCard> variant must be one of 'panel' | 'option'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:div|section|article)$/]",
        "message": "<GlassCard> as must be one of 'div' | 'section' | 'article'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|className|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, className, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:menu|x)$/]",
        "message": "<Icon> name must be one of 'menu' | 'x'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|subtitle|imageSrc|onClick|rotate|width|style|key|ref|className|style|children)$/]",
        "message": "<PolaroidCard> doesn't accept that prop. Declared props: name, subtitle, imageSrc, onClick, rotate, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidGallery'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|dataType|instagramIconSrc|style|key|ref|className|style|children)$/]",
        "message": "<PolaroidGallery> doesn't accept that prop. Declared props: data, dataType, instagramIconSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidGallery'] > JSXAttribute[name.name='dataType'] > Literal[value!=/^(?:event|officer)$/]",
        "message": "<PolaroidGallery> dataType must be one of 'event' | 'officer'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PopupDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|imagePath|date|description|signUpLink|role|major|whyJoined|favoriteMemory|instagram|key|ref|className|style|children)$/]",
        "message": "<PopupDatum> doesn't accept that prop. Declared props: id, name, imagePath, date, description, signUpLink, role, major, whyJoined, favoriteMemory, instagram."
      },
      {
        "selector": "JSXOpeningElement[name.name='PreviousOfficer'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|role|key|ref|className|style|children)$/]",
        "message": "<PreviousOfficer> doesn't accept that prop. Declared props: id, name, role."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|period|notes|style|key|ref|className|style|children)$/]",
        "message": "<PriceCard> doesn't accept that prop. Declared props: price, period, notes, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarEvent'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|date|description|signUpLink|type|key|ref|className|style|children)$/]",
        "message": "<CalendarEvent> doesn't accept that prop. Declared props: id, name, date, description, signUpLink, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarEvent'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:regular|potlock picnic|weekly meeting)$/]",
        "message": "<CalendarEvent> type must be one of 'regular' | 'potlock picnic' | 'weekly meeting'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
